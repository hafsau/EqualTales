# EqualTales Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic API Key (Claude writes, classifies and checks the stories)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key (illustrations)
# Get yours at: https://platform.openai.com/
OPENAI_API_KEY=sk-proj-your-key-here

# Optional: pinned models (these are the defaults)
# CLAUDE_STORY_MODEL=claude-opus-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_STORY_EFFORT=medium
# IMAGE_MODEL=gpt-image-1-mini

# Optional: Set to "true" to use Goose orchestration
USE_GOOSE=false
